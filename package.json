{
  "name": "reglamentos-locales",
  "version": "1.1.0",
  "private": true,
  "description": "Consulta privada de reglamentos con fuentes, OCR y Ollama local sin Internet",
  "author": "Folio",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win portable zip --x64 --publish never && node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.folio.reglamentos",
    "productName": "Folio",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "public/**",
      "scripts/ocr.ps1",
      "scripts/ollama-firewall.ps1",
      "server.mjs",
      "package.json",
      "README.md",
      "MANUAL-IA.md"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "desktop/icon.ico",
      "signExecutable": false,
      "artifactName": "Folio-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Folio-${version}-portable-${arch}.exe"
    }
  }
}
